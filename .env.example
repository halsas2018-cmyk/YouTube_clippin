# youtubr_clipper — environment variable template
# Copy to .env and fill in your values before running the clip-selection stage.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# LLM provider selection (transcript_discovery stage)
# ---------------------------------------------------------------------------

# Which LLM provider to use.  One of: openai | anthropic | google
CLIPPER_LLM_PROVIDER=openai

# Model name override.  Leave unset to use the provider's default:
#   openai    → gpt-4o-mini
#   anthropic → claude-3-5-haiku-20241022
#   google    → gemini-3.1-flash-lite
# CLIPPER_LLM_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# OpenAI (provider=openai)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Optional: override the base URL to use an OpenAI-compatible endpoint
# (Azure OpenAI, Together, Fireworks, local Ollama, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Anthropic (provider=anthropic)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Google Gemini (provider=google)
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=AIza...

# ---------------------------------------------------------------------------
# Freesound (audio acquisition — Stage 10)
# ---------------------------------------------------------------------------
# Get a free key at: https://freesound.org/apiv2/apply
# Without this, placeholder WAV tones are used instead of real music/SFX.
# FREESOUND_API_KEY=your_freesound_key_here

